@model ResultOrderListDto
@{
    ViewData["Title"] = "Siparişler · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "orders";
    ViewData["Crumb"] = "Siparişler";
    // Bütün veri OrderService.GetAdminListAsync'ten gelen ResultOrderListDto'da.
    OrderStatus? status = Model.Filter.Status;
    OrderChannel? channel = Model.Filter.Channel;
    int currentPage = Model.Filter.Page;
    int totalPages = Model.TotalPages;
    string Link(int p) => $"/admin/orders?status={status}&channel={channel}&q={Uri.EscapeDataString(Model.Filter.Q ?? "")}&page={p}";
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Sipariş Yönetimi</h1>
    <p class="adm-page-sub">Her siparişi tezgâhtan müşteriye kadar takip edin.</p>
  </div>
</div>

<section class="adm-stats">
  @foreach (var s in new[] { OrderStatus.Received, OrderStatus.Preparing, OrderStatus.Ready, OrderStatus.Delivered })
  {
    <a href="/admin/orders?status=@s" class="adm-stat text-decoration-none">
      <div><div class="adm-stat-value">@Model.StatusCounts[s]</div><div class="adm-stat-label">@AdminDisplay.StatusLabel(s)</div></div>
    </a>
  }
</section>

<section class="adm-card">
  <form class="adm-toolbar" method="get" action="/admin/orders">
    <input type="search" class="adm-input" name="q" value="@Model.Filter.Q" placeholder="Sipariş no, müşteri veya telefon..." />
    <select class="adm-select" name="status">
      <option value="">Tüm Durumlar</option>
      @foreach (var s in Enum.GetValues<OrderStatus>())
      {
        <option value="@s" selected="@(status == s)">@AdminDisplay.StatusLabel(s)</option>
      }
    </select>
    <select class="adm-select" name="channel">
      <option value="">Tüm Kanallar</option>
      @foreach (var c in Enum.GetValues<OrderChannel>())
      {
        <option value="@c" selected="@(channel == c)">@AdminDisplay.ChannelLabel(c)</option>
      }
    </select>
    <button type="submit" class="adm-btn adm-btn-light">Filtrele</button>
    <a href="/admin/orders" class="adm-btn adm-btn-ghost">Temizle</a>
    <span class="adm-counter"><strong>@Model.Total</strong> sipariş</span>
  </form>

  @if (Model.Orders.Count == 0)
  {
    <div class="adm-empty"><h3>Sipariş bulunamadı</h3></div>
  }
  else
  {
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>Sipariş</th><th>Müşteri / Masa</th><th>Kanal</th><th class="num">Ürün</th><th class="end">Toplam</th><th>Durum</th><th>Tarih</th><th></th></tr></thead>
        <tbody>
          @foreach (var order in Model.Orders)
          {
            <tr>
              <td><a href="/admin/orders/@order.Id" class="pg-mono">@order.OrderNo</a></td>
              <td>@AdminDisplay.Who(order)</td>
              <td>@AdminDisplay.ChannelLabel(order.Channel)</td>
              <td class="num">@order.Details.Sum(d => d.Quantity)</td>
              <td class="end">@AdminDisplay.Money(order.Total)</td>
              <td><span class="adm-badge @AdminDisplay.StatusBadge(order.Status)">@AdminDisplay.StatusLabel(order.Status)</span></td>
              <td>@AdminDisplay.Date(order.CreatedAt)</td>
              <td class="end"><a href="/admin/orders/@order.Id" class="adm-btn adm-btn-ghost adm-btn-sm">Görüntüle</a></td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <div class="adm-pager">
      <span>Sayfa @currentPage / @totalPages</span>
      <nav class="adm-pages">
        @for (var p = 1; p <= totalPages; p++)
        {
          <a class="adm-page-btn@(p == currentPage ? " active" : "")" href="@Link(p)">@p</a>
        }
      </nav>
    </div>
  }
</section>
