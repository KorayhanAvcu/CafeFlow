@model ResultNotificationPageDto
@{
    ViewData["Title"] = "Bildirimler · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "notifications";
    ViewData["Crumb"] = "Bildirimler";
    // Bütün veri NotificationService.GetPageAsync'ten gelen ResultNotificationPageDto'da.
    NotificationTarget? target = Model.Target;
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Bildirimler</h1>
    <p class="adm-page-sub">Sipariş verildiğinde veya durumu değiştiğinde Observer deseni tarafından yazılır.</p>
  </div>
  <form method="post" action="/admin/notifications/mark-read">
    @Html.AntiForgeryToken()
    <input type="hidden" name="target" value="@target" />
    <button type="submit" class="adm-btn adm-btn-light">Okundu yap</button>
  </form>
</div>

<section class="adm-stats">
  <a href="/admin/notifications" class="adm-stat text-decoration-none"><div><div class="adm-stat-value">@Model.UnreadAll</div><div class="adm-stat-label">Okunmamış · tümü</div></div></a>
  @foreach (var t in Enum.GetValues<NotificationTarget>())
  {
    <a href="/admin/notifications?target=@t" class="adm-stat text-decoration-none"><div><div class="adm-stat-value">@Model.UnreadByTarget[t]</div><div class="adm-stat-label">Okunmamış · @AdminDisplay.TargetLabel(t)</div></div></a>
  }
</section>

<section class="adm-card">
  <div class="adm-toolbar">
    <a href="/admin/notifications?target=@target" class="adm-btn adm-btn-light">Tümü</a>
    <a href="/admin/notifications?target=@target&unread=true" class="adm-btn adm-btn-light">Sadece okunmamışlar</a>
    <span class="adm-counter"><strong>@Model.Notifications.Count</strong> bildirim</span>
  </div>
  <ul class="pg-notes">
    @foreach (var n in Model.Notifications)
    {
      <li class="pg-note@(n.IsRead ? "" : " unread")">
        <div class="pg-note-body">
          <p>@n.Message</p>
          <div class="pg-note-meta">
            <span class="adm-badge adm-badge-neutral">@AdminDisplay.TargetLabel(n.Target)</span>
            <span>@AdminDisplay.Date(n.CreatedAt)</span>
            @if (n.OrderId != null) { <a href="/admin/orders/@n.OrderId">@n.OrderNo</a> }
          </div>
        </div>
      </li>
    }
  </ul>
</section>
