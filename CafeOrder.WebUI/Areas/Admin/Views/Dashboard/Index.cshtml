@model List<ResultOrderDto>
@{
    ViewData["Title"] = "Dashboard · CafeFlow Management Studio";
    ViewData["AdminPage"] = "dashboard";
    ViewData["Crumb"] = "Dashboard";
    Dictionary<OrderStatus, int> statusCounts = ViewBag.StatusCounts;
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Dashboard</h1>
    <p class="adm-page-sub">@DateTime.Today.ToString("dd MMMM yyyy")</p>
  </div>
</div>

<section class="adm-stats">
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-rose"><i class="bi bi-bag-check"></i></span>
    <div><div class="adm-stat-value">@ViewBag.TodayOrders</div><div class="adm-stat-label">Orders today</div></div></div>
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-green"><i class="bi bi-cash-coin"></i></span>
    <div><div class="adm-stat-value">@AdminDisplay.Money(ViewBag.TodayRevenue)</div><div class="adm-stat-label">Revenue today</div></div></div>
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-peach"><i class="bi bi-fire"></i></span>
    <div><div class="adm-stat-value">@ViewBag.OpenOrders</div><div class="adm-stat-label">Open orders</div></div></div>
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-blue"><i class="bi bi-calendar-week"></i></span>
    <div><div class="adm-stat-value">@AdminDisplay.Money(ViewBag.WeekRevenue)</div><div class="adm-stat-label">Last 7 days</div></div></div>
</section>

<div class="row g-4">
  <div class="col-xl-8">
    <section class="adm-card mb-4">
      <div class="pg-card-head"><h2>Latest orders</h2><a href="/admin/orders" class="adm-btn adm-btn-ghost adm-btn-sm">All orders</a></div>
      @if (Model.Count == 0)
      {
        <div class="pg-card-body pg-muted">No orders yet.</div>
      }
      else
      {
        <div class="adm-table-wrap">
          <table class="adm-table">
            <thead><tr><th>Order</th><th>Customer / Table</th><th class="end">Total</th><th>Status</th></tr></thead>
            <tbody>
              @foreach (var order in Model)
              {
                <tr>
                  <td><a href="/admin/orders/@order.Id" class="pg-mono">@order.OrderNo</a></td>
                  <td>@AdminDisplay.Who(order)</td>
                  <td class="end">@AdminDisplay.Money(order.Total)</td>
                  <td><span class="adm-badge @AdminDisplay.StatusBadge(order.Status)">@order.Status</span></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </section>

    <section class="adm-card">
      <div class="pg-card-head"><h2>Best sellers</h2></div>
      <div class="adm-table-wrap">
        <table class="adm-table">
          <thead><tr><th>Product</th><th class="num">Sold</th><th class="end">Revenue</th></tr></thead>
          <tbody>
            @foreach (var item in ViewBag.BestSellers)
            {
              <tr><td>@item.Name</td><td class="num">@item.Quantity</td><td class="end">@AdminDisplay.Money(item.Revenue)</td></tr>
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="col-xl-4">
    <section class="adm-card">
      <div class="pg-card-head"><h2>Orders by status</h2></div>
      <div class="pg-card-body">
        <ul class="pg-meters">
          @foreach (var item in statusCounts)
          {
            <li>
              <a href="/admin/orders?status=@item.Key" class="pg-meter-top text-decoration-none"><span>@item.Key</span><strong>@item.Value</strong></a>
            </li>
          }
        </ul>
      </div>
    </section>
  </div>
</div>
