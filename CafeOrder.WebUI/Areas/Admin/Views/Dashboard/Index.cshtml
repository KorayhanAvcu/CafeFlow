@model ResultDashboardDto
@{
    ViewData["Title"] = "Panel · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "dashboard";
    ViewData["Crumb"] = "Panel";
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Panel</h1>
    <p class="adm-page-sub">@AdminDisplay.LongDate(DateTime.Today)</p>
  </div>
</div>

<section class="adm-stats">
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-rose"><i class="bi bi-bag-check"></i></span>
    <div><div class="adm-stat-value">@Model.TodayOrders</div><div class="adm-stat-label">Bugünkü sipariş</div></div></div>
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-green"><i class="bi bi-cash-coin"></i></span>
    <div><div class="adm-stat-value">@AdminDisplay.Money(Model.TodayRevenue)</div><div class="adm-stat-label">Bugünkü ciro</div></div></div>
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-peach"><i class="bi bi-fire"></i></span>
    <div><div class="adm-stat-value">@Model.OpenOrders</div><div class="adm-stat-label">Açık sipariş</div></div></div>
  <div class="adm-stat"><span class="adm-stat-icon adm-tone-blue"><i class="bi bi-calendar-week"></i></span>
    <div><div class="adm-stat-value">@AdminDisplay.Money(Model.WeekRevenue)</div><div class="adm-stat-label">Son 7 gün</div></div></div>
</section>

<div class="row g-4">
  <div class="col-xl-8">
    <section class="adm-card mb-4">
      <div class="pg-card-head"><h2>Son siparişler</h2><a href="/admin/orders" class="adm-btn adm-btn-ghost adm-btn-sm">Tüm siparişler</a></div>
      @if (Model.LatestOrders.Count == 0)
      {
        <div class="pg-card-body pg-muted">Henüz sipariş yok.</div>
      }
      else
      {
        <div class="adm-table-wrap">
          <table class="adm-table">
            <thead><tr><th>Sipariş</th><th>Müşteri / Masa</th><th class="end">Toplam</th><th>Durum</th></tr></thead>
            <tbody>
              @foreach (var order in Model.LatestOrders)
              {
                <tr>
                  <td><a href="/admin/orders/@order.Id" class="pg-mono">@order.OrderNo</a></td>
                  <td>@AdminDisplay.Who(order)</td>
                  <td class="end">@AdminDisplay.Money(order.Total)</td>
                  <td><span class="adm-badge @AdminDisplay.StatusBadge(order.Status)">@AdminDisplay.StatusLabel(order.Status)</span></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </section>

    <section class="adm-card">
      <div class="pg-card-head"><h2>En çok satanlar</h2></div>
      <div class="adm-table-wrap">
        <table class="adm-table">
          <thead><tr><th>Ürün</th><th class="num">Satılan</th><th class="end">Ciro</th></tr></thead>
          <tbody>
            @foreach (var item in Model.BestSellers)
            {
              <tr><td>@item.Name</td><td class="num">@item.Quantity</td><td class="end">@AdminDisplay.Money(item.Revenue)</td></tr>
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="col-xl-4">
    <section class="adm-card">
      <div class="pg-card-head"><h2>Durumlara göre siparişler</h2></div>
      <div class="pg-card-body">
        <ul class="pg-meters">
          @foreach (var item in Model.StatusCounts)
          {
            <li>
              <a href="/admin/orders?status=@item.Key" class="pg-meter-top text-decoration-none"><span>@AdminDisplay.StatusLabel(item.Key)</span><strong>@item.Value</strong></a>
            </li>
          }
        </ul>
      </div>
    </section>
  </div>
</div>
