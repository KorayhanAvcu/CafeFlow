@model ResultDashboardDto
@{
    ViewData["Title"] = "Panel · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "dashboard";
    ViewData["Crumb"] = "Panel";
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Panel</h1>
    <p class="adm-page-sub">@AdminDisplay.LongDate(DateTime.Today)</p>
  </div>
</div>

@await Component.InvokeAsync("_DashboardStatCards", new { dashboard = Model })

<div class="row g-4">
  <div class="col-xl-8">
    @await Component.InvokeAsync("_DashboardLatestOrders", new { dashboard = Model })

    @await Component.InvokeAsync("_DashboardBestSellers", new { dashboard = Model })
  </div>

  <div class="col-xl-4">
    @await Component.InvokeAsync("_DashboardStatusCounts", new { dashboard = Model })
  </div>
</div>
