@* Son siparişler tablosu. *@
@model ResultDashboardDto
<section class="adm-card mb-4">
  <div class="pg-card-head"><h2>Son siparişler</h2><a href="/admin/orders" class="adm-btn adm-btn-ghost adm-btn-sm">Tüm siparişler</a></div>
  @if (Model.LatestOrders.Count == 0)
  {
    <div class="pg-card-body pg-muted">Henüz sipariş yok.</div>
  }
  else
  {
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead><tr><th>Sipariş</th><th>Müşteri / Masa</th><th class="end">Toplam</th><th>Durum</th></tr></thead>
        <tbody>
          @foreach (var order in Model.LatestOrders)
          {
            <tr>
              <td><a href="/admin/orders/@order.Id" class="pg-mono">@order.OrderNo</a></td>
              <td>@AdminDisplay.Who(order)</td>
              <td class="end">@AdminDisplay.Money(order.Total)</td>
              <td><span class="adm-badge @AdminDisplay.StatusBadge(order.Status)">@AdminDisplay.StatusLabel(order.Status)</span></td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>
