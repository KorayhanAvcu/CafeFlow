@{
    var page = ViewData["AdminPage"] as string ?? "";
    var userName = User.FindFirst(CafeOrder.WebUI.Identity.AppClaimsPrincipalFactory.FullNameClaim)?.Value ?? User.Identity?.Name ?? "Admin";
    var userEmail = User.Identity?.Name ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"]</title>
  <meta name="robots" content="noindex" />

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/admin-pages.css" asp-append-version="true" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="adm">
  @Html.AntiForgeryToken()

  <!-- ============ SHARED ADMIN SHELL: SIDEBAR ============ -->
  @await Component.InvokeAsync("AdminSidebar", new { activePage = page })
  <div class="adm-backdrop" id="admBackdrop"></div>

  <div class="adm-main">
    <!-- ============ SHARED ADMIN SHELL: TOP NAVBAR ============ -->
    <header class="adm-topbar">
      <button type="button" class="adm-icon-btn bordered" id="sidebarToggle" aria-label="Toggle sidebar" aria-controls="admSidebar" aria-expanded="true">
        <i class="bi bi-layout-sidebar"></i>
      </button>
      <nav class="adm-crumbs" aria-label="Breadcrumb">
        <span class="adm-hide-sm">Management</span>
        <i class="bi bi-chevron-right adm-hide-sm"></i>
        <strong>@ViewData["Crumb"]</strong>
      </nav>

      <div class="adm-topbar-right">
        <!-- Quick actions -->
        <div class="dropdown">
          <button type="button" class="adm-icon-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Quick actions" title="Quick actions">
            <i class="bi bi-lightning-charge"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><h6 class="dropdown-header">Quick actions</h6></li>
            <li><a class="dropdown-item" href="/admin/categories/new"><i class="bi bi-plus-circle"></i> Add Category</a></li>
            <li><a class="dropdown-item" href="/admin/products/new"><i class="bi bi-plus-square"></i> Add Product</a></li>
            <li><a class="dropdown-item" href="/admin/products"><i class="bi bi-cup-straw"></i> View Products</a></li>
            <li><a class="dropdown-item" href="/admin/orders"><i class="bi bi-receipt"></i> View Orders</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Open customer site</a></li>
          </ul>
        </div>

        <!-- Notifications (written by the Observer pattern) -->
        @await Component.InvokeAsync("AdminNotifications")

        <!-- Profile -->
        <div class="dropdown">
          <button type="button" class="adm-user-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
            <span class="adm-avatar">@AdminDisplay.Initials(userName)</span>
            <span class="adm-user-meta">
              <strong>@userName</strong>
              <small>Admin</small>
            </span>
            <i class="bi bi-chevron-down small text-muted adm-hide-sm"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><h6 class="dropdown-header text-truncate" style="max-width:240px">Signed in as @userEmail</h6></li>
            <li><a class="dropdown-item" href="/admin/account"><i class="bi bi-person"></i> My Account</a></li>
            <li><a class="dropdown-item" href="/admin/account#cur"><i class="bi bi-key"></i> Change Password</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
              <form method="post" action="/admin/logout" class="m-0">
                @Html.AntiForgeryToken()
                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right"></i> Logout</button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <main class="adm-content" id="main">
      @RenderBody()
    </main>

    <footer class="adm-footer">
      <span>© @DateTime.Now.Year CafeFlow Management Studio</span>
    </footer>
  </div>

  <!-- Bootstrap: sadece açılır menüler için. admin-shell.js: sadece sol menüyü daraltıp açar. -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/admin-shell.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
