@{
    string active = ViewBag.ActivePage;
    string Css(string name) => active == name ? "adm-nav-link active" : "adm-nav-link";
    int newOrders = ViewBag.NewOrderCount;
    int unread = ViewBag.UnreadCount;
    string userName = ViewBag.UserName;
}
<aside class="adm-sidebar" id="admSidebar" aria-label="Yönetim menüsü">
  <a href="/admin" class="adm-brand">
    <span class="adm-brand-mark"><i class="bi bi-cup-hot-fill"></i></span>
    <span class="adm-brand-text"><strong>Cafe<span>Flow</span></strong><small>Yönetim Paneli</small></span>
  </a>

  <nav class="adm-nav">
    <div class="adm-nav-group">
      <div class="adm-nav-label">Genel Bakış</div>
      <a href="/admin" class="@Css("dashboard")"><i class="bi bi-grid-1x2"></i><span>Panel</span></a>
    </div>
    <div class="adm-nav-group">
      <div class="adm-nav-label">Yönetim</div>
      <a href="/admin/categories" class="@Css("categories")"><i class="bi bi-tags"></i><span>Kategoriler</span><em class="adm-nav-count">@ViewBag.CategoryCount</em></a>
      <a href="/admin/products" class="@Css("products")"><i class="bi bi-cup-straw"></i><span>Ürünler</span><em class="adm-nav-count">@ViewBag.ProductCount</em></a>
      <a href="/admin/orders" class="@Css("orders")"><i class="bi bi-receipt"></i><span>Siparişler</span>
        @if (newOrders > 0) { <em class="adm-nav-count" title="Yeni siparişler">@newOrders</em> }
      </a>
      <a href="/admin/tables" class="@Css("tables")"><i class="bi bi-qr-code"></i><span>Masalar</span></a>
      <a href="/admin/customers" class="@Css("customers")"><i class="bi bi-people"></i><span>Müşteriler</span></a>
    </div>
    <div class="adm-nav-group">
      <div class="adm-nav-label">Sistem</div>
      <a href="/admin/notifications" class="@Css("notifications")"><i class="bi bi-bell"></i><span>Bildirimler</span>
        @if (unread > 0) { <em class="adm-nav-count">@unread</em> }
      </a>
    </div>
  </nav>

  <div class="adm-profile">
    <a href="/admin/account" class="adm-avatar text-decoration-none">@AdminDisplay.Initials(userName)</a>
    <div class="adm-profile-text"><strong>@userName</strong><small>Yönetici</small></div>
    <form method="post" action="/admin/logout" class="m-0">
      @Html.AntiForgeryToken()
      <button type="submit" class="adm-icon-btn" title="Çıkış yap" aria-label="Çıkış yap"><i class="bi bi-box-arrow-right"></i></button>
    </form>
  </div>
</aside>
