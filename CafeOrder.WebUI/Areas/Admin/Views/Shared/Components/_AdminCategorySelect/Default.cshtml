@* _AdminCategorySelectViewComponent: kategori açılır listesi (ürün filtresi ve ürün formu). *@
@model List<ResultCategoryDto>
@{
    string name = ViewBag.Name;
    int? selected = ViewBag.Selected;
    string? emptyText = ViewBag.EmptyText;
    string? elementId = ViewBag.ElementId;
    string cssClass = ViewBag.CssClass;
}
<select class="@cssClass" id="@elementId" name="@name">
  @if (emptyText != null)
  {
    <option value="">@emptyText</option>
  }
  @foreach (var c in Model)
  {
    <option value="@c.Id" selected="@(selected == c.Id)">@c.Name</option>
  }
</select>
