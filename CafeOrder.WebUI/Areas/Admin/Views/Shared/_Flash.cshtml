@* One-time message after a form post (Post/Redirect/Get). An explicit error from the page wins. *@
@model string?
@{
    var message = Model ?? TempData["Flash"] as string;
    var type = Model is not null ? "warn" : TempData["FlashType"] as string ?? "info";
}
@if (!string.IsNullOrEmpty(message))
{
  <div class="adm-callout @type mb-4" role="@(type == "warn" ? "alert" : "status")">
    <i class="bi @(type == "warn" ? "bi-exclamation-triangle" : "bi-check2-circle")"></i>
    <span>@message</span>
  </div>
}
