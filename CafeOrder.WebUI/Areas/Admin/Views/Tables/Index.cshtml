@model List<ResultTableDto>
@{
    ViewData["Title"] = "Masalar · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "tables";
    ViewData["Crumb"] = "Masalar";
    UpdateTableDto form = ViewBag.Form;
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Masalar ve QR Kodları</h1>
    <p class="adm-page-sub">Misafir QR kartı okutur, sipariş o masaya bağlanır.</p>
  </div>
</div>

<partial name="_ErrorMessage" model="@((string?)ViewBag.Error)" />

<div class="row g-4">
  <div class="col-xl-8">
    <section class="adm-card">
      <div class="adm-table-wrap">
        <table class="adm-table">
          <thead><tr><th>Masa</th><th>QR kodu</th><th class="num">Sipariş</th><th>Durum</th><th class="end"></th></tr></thead>
          <tbody>
            @foreach (var t in Model)
            {
              <tr>
                <td><strong>Masa @t.Number</strong><br /><small class="pg-muted">@t.Area</small></td>
                <td class="pg-mono"><a href="/cart?qr=@t.QrToken" target="_blank" title="QR kartın açtığı adres">@t.QrToken</a></td>
                <td class="num">@t.OrderCount</td>
                <td>
                  <form method="post" action="/admin/tables/@t.Id/status" class="pg-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="active" value="@(t.IsActive ? "false" : "true")" />
                    <button type="submit" class="adm-badge @(t.IsActive ? "adm-badge-success" : "adm-badge-inactive") border-0" title="Değiştirmek için tıklayın">@(t.IsActive ? "Aktif" : "Pasif")</button>
                  </form>
                </td>
                <td class="end">
                  <a href="/admin/tables?edit=@t.Id" class="adm-btn adm-btn-ghost adm-btn-sm">Düzenle</a>
                  <form method="post" action="/admin/tables/@t.Id/regenerate" class="pg-inline" onsubmit="return confirm('Eski QR kart artık çalışmayacak. Devam edilsin mi?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="adm-btn adm-btn-ghost adm-btn-sm" title="Yeni QR kodu" aria-label="Yeni QR kodu"><i class="bi bi-arrow-repeat"></i></button>
                  </form>
                  <form method="post" action="/admin/tables/@t.Id/delete" class="pg-inline" onsubmit="return confirm('Bu masa silinsin mi?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="adm-btn adm-btn-ghost adm-btn-sm" title="Sil" aria-label="Sil"><i class="bi bi-trash3"></i></button>
                  </form>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="col-xl-4">
    <form method="post" action="/admin/tables/save" class="adm-card">
      @Html.AntiForgeryToken()
      <input type="hidden" name="Id" value="@form.Id" />
      <div class="pg-card-head"><h2>@(form.Id == 0 ? "Masa ekle" : $"Masa {form.Number} düzenleniyor")</h2></div>
      <div class="pg-card-body row g-3">
        <div class="col-5">
          <label class="adm-label" for="number">Numara</label>
          <input class="adm-input" id="number" name="Number" type="number" value="@form.Number" />
        </div>
        <div class="col-7">
          <label class="adm-label" for="area">Bölge</label>
          <input class="adm-input" id="area" name="Area" value="@form.Area" placeholder="Bahçe Köşesi" />
        </div>
        <div class="col-12">
          <label><input type="checkbox" name="IsActive" value="true" checked="@form.IsActive" /> QR siparişi kabul eder</label>
          <input type="hidden" name="IsActive" value="false" />
        </div>
      </div>
      <div class="pg-form-foot">
        @if (form.Id != 0) { <a href="/admin/tables" class="adm-btn adm-btn-light">Yeni masa ekle</a> }
        <button type="submit" class="adm-btn adm-btn-primary">Kaydet</button>
      </div>
    </form>
  </div>
</div>
