@model UpdateCategoryDto
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = (isNew ? "Yeni Kategori" : Model.Name) + " · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "categories";
    ViewData["Crumb"] = isNew ? "Yeni Kategori" : "Kategoriyi Düzenle";
}

<div class="adm-page-head">
  <div>
    <a href="/admin/categories" class="adm-btn adm-btn-ghost adm-btn-sm mb-2"><i class="bi bi-arrow-left"></i> Tüm kategoriler</a>
    <h1 class="adm-page-title">@(isNew ? "Yeni kategori" : Model.Name)</h1>
  </div>
</div>

@await Component.InvokeAsync("_AdminErrorMessage", new { message = (string?)ViewBag.Error })

<form method="post" action="/admin/categories/save" class="adm-card">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="@Model.Id" />
  <div class="pg-card-body row g-3">
    <div class="col-md-8">
      <label class="adm-label" for="name">Ad</label>
      <input class="adm-input" id="name" name="Name" value="@Model.Name" />
    </div>
    <div class="col-md-4">
      <label class="adm-label" for="order">Sıra (boş = en sona)</label>
      <input class="adm-input" id="order" name="DisplayOrder" type="number" value="@(Model.DisplayOrder == 0 ? "" : Model.DisplayOrder)" />
    </div>
    <div class="col-12">
      <label class="adm-label" for="description">Açıklama</label>
      <textarea class="adm-textarea" id="description" name="Description" rows="3">@Model.Description</textarea>
    </div>
    <div class="col-12">
      <label class="adm-label" for="image">Görsel adresi (URL)</label>
      <input class="adm-input" id="image" name="ImageUrl" value="@Model.ImageUrl" />
    </div>
    <div class="col-12">
      <label><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" /> Aktif (menüde görünür)</label>
      <input type="hidden" name="IsActive" value="false" />
    </div>
  </div>
  <div class="pg-form-foot">
    <a href="/admin/categories" class="adm-btn adm-btn-light">Vazgeç</a>
    <button type="submit" class="adm-btn adm-btn-primary">Kaydet</button>
  </div>
</form>
