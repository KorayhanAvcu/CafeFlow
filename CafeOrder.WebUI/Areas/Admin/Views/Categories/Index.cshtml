@model List<ResultCategoryDto>
@{
    ViewData["Title"] = "Categories · CafeFlow Management Studio";
    ViewData["AdminPage"] = "categories";
    ViewData["Crumb"] = "Categories";
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Category Management</h1>
    <p class="adm-page-sub">@Model.Count categories · @Model.Count(c => c.IsActive) active · @Model.Sum(c => c.ProductCount) products</p>
  </div>
  <a href="/admin/categories/new" class="adm-btn adm-btn-primary"><i class="bi bi-plus-lg"></i> Add Category</a>
</div>

<partial name="_Flash" model="null" />

<section class="adm-card">
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr><th>Category</th><th>Description</th><th class="num">Products</th><th class="num">Order</th><th>Status</th><th class="end"></th></tr></thead>
      <tbody>
        @foreach (var c in Model)
        {
          <tr>
            <td><strong>@c.Name</strong><br /><small class="pg-muted">@c.Code · /@c.Slug</small></td>
            <td>@c.Description</td>
            <td class="num">@c.ProductCount</td>
            <td class="num">@c.DisplayOrder</td>
            <td>
              <form method="post" action="/admin/categories/@c.Id/status" class="pg-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="active" value="@(c.IsActive ? "false" : "true")" />
                <button type="submit" class="adm-badge @(c.IsActive ? "adm-badge-success" : "adm-badge-inactive") border-0">@(c.IsActive ? "Active" : "Inactive")</button>
              </form>
            </td>
            <td class="end">
              <a href="/admin/categories/@c.Id/edit" class="adm-btn adm-btn-ghost adm-btn-sm">Edit</a>
              <form method="post" action="/admin/categories/@c.Id/delete" class="pg-inline" onsubmit="return confirm('Delete this category?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="adm-btn adm-btn-ghost adm-btn-sm"><i class="bi bi-trash3"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</section>
