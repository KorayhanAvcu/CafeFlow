@model List<ResultProductDto>
@{
    ViewData["Title"] = "Ürünler · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "products";
    ViewData["Crumb"] = "Ürünler";
    int? selected = ViewBag.Category;
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Ürün Yönetimi</h1>
    <p class="adm-page-sub">@Model.Count ürün</p>
  </div>
  <a href="/admin/products/new" class="adm-btn adm-btn-primary"><i class="bi bi-plus-lg"></i> Ürün Ekle</a>
</div>

<vc:error-message message="@((string?)ViewBag.Error)" />

<section class="adm-card">
  <form class="adm-toolbar" method="get" action="/admin/products">
    <input type="search" class="adm-input" name="q" value="@ViewBag.Search" placeholder="Ada göre ara..." />
    <vc:category-select name="category" selected="@selected" empty-text="Tüm Kategoriler" />
    <button type="submit" class="adm-btn adm-btn-light">Filtrele</button>
  </form>

  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr><th>Ürün</th><th>Kategori</th><th class="end">Fiyat</th><th>Rozet</th><th>Durum</th><th class="end"></th></tr></thead>
      <tbody>
        @foreach (var p in Model)
        {
          <tr>
            <td><strong>@p.Name</strong></td>
            <td>@p.CategoryName</td>
            <td class="end">@AdminDisplay.Money(p.BasePrice)</td>
            <td>@p.Badge</td>
            <td>
              <form method="post" action="/admin/products/@p.Id/status" class="pg-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="active" value="@(p.IsActive ? "false" : "true")" />
                <button type="submit" class="adm-badge @(p.IsActive ? "adm-badge-success" : "adm-badge-inactive") border-0" title="Değiştirmek için tıklayın">@(p.IsActive ? "Aktif" : "Pasif")</button>
              </form>
            </td>
            <td class="end">
              <a href="/admin/products/@p.Id/edit" class="adm-btn adm-btn-ghost adm-btn-sm">Düzenle</a>
              <form method="post" action="/admin/products/@p.Id/delete" class="pg-inline" onsubmit="return confirm('Bu ürün silinsin mi?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="adm-btn adm-btn-ghost adm-btn-sm" title="Sil" aria-label="Sil"><i class="bi bi-trash3"></i></button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</section>
