@model UpdateProductDto
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = (isNew ? "New Product" : Model.Name) + " · CafeFlow Management Studio";
    ViewData["AdminPage"] = "products";
    ViewData["Crumb"] = isNew ? "New Product" : "Edit Product";
    List<ResultCategoryDto> categories = ViewBag.Categories;
    var badges = new[] { "Best Seller", "New", "Popular", "Chef's Choice" };
}

<div class="adm-page-head">
  <div>
    <a href="/admin/products" class="adm-btn adm-btn-ghost adm-btn-sm mb-2"><i class="bi bi-arrow-left"></i> All products</a>
    <h1 class="adm-page-title">@(isNew ? "New product" : Model.Name)</h1>
  </div>
</div>

<partial name="_Flash" model="@((string?)ViewBag.Error)" />

<form method="post" action="/admin/products/save" class="adm-card">
  @Html.AntiForgeryToken()
  <input type="hidden" name="Id" value="@Model.Id" />
  <div class="pg-card-body row g-3">
    <div class="col-md-8">
      <label class="adm-label" for="name">Name</label>
      <input class="adm-input" id="name" name="Name" value="@Model.Name" />
    </div>
    <div class="col-md-4">
      <label class="adm-label" for="category">Category</label>
      <select class="adm-select w-100" id="category" name="CategoryId">
        @foreach (var c in categories)
        {
          <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
        }
      </select>
    </div>
    <div class="col-md-4">
      <label class="adm-label" for="price">Price (₺)</label>
      <input class="adm-input" id="price" name="BasePrice" type="number" step="0.01" value="@Model.BasePrice" />
    </div>
    <div class="col-md-4">
      <label class="adm-label" for="badge">Badge</label>
      <select class="adm-select w-100" id="badge" name="Badge">
        <option value="">No badge</option>
        @foreach (var b in badges)
        {
          <option value="@b" selected="@(Model.Badge == b)">@b</option>
        }
      </select>
    </div>
    <div class="col-12">
      <label class="adm-label" for="description">Short description</label>
      <textarea class="adm-textarea" id="description" name="Description" rows="2">@Model.Description</textarea>
    </div>
    <div class="col-12">
      <label class="adm-label" for="image">Image URL</label>
      <input class="adm-input" id="image" name="ImageUrl" value="@Model.ImageUrl" />
    </div>
    <div class="col-12 d-flex gap-4 flex-wrap">
      <label><input type="checkbox" name="IsCustomizable" value="true" checked="@Model.IsCustomizable" /> Customizable (size, milk, extras)</label>
      <label><input type="checkbox" name="IsVegetarian" value="true" checked="@Model.IsVegetarian" /> Vegetarian</label>
      <label><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" /> Active</label>
      <input type="hidden" name="IsActive" value="false" />
    </div>
  </div>
  <div class="pg-form-foot">
    <a href="/admin/products" class="adm-btn adm-btn-light">Cancel</a>
    <button type="submit" class="adm-btn adm-btn-primary">Save</button>
  </div>
</form>
