@model ResultAccountDto
@{
    ViewData["Title"] = "Hesabım · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "account";
    ViewData["Crumb"] = "Hesabım";
    string? error = Model.Errors.Count > 0 ? string.Join(" ", Model.Errors) : null;
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Hesabım</h1>
    <p class="adm-page-sub">Giriş bilgileriniz ve şifreniz.</p>
  </div>
  <form method="post" action="/admin/logout" class="m-0">
    @Html.AntiForgeryToken()
    <button type="submit" class="adm-btn adm-btn-light"><i class="bi bi-box-arrow-right"></i> Çıkış Yap</button>
  </form>
</div>

<partial name="_ErrorMessage" model="error" />
@if (Model.Succeeded)
{
  <div class="adm-callout info mb-4" role="status">
    <i class="bi bi-check2-circle"></i>
    <span>Şifreniz değiştirildi.</span>
  </div>
}

<div class="row g-4">
  <div class="col-xl-5">
    <section class="adm-card" aria-labelledby="profileTitle">
      <div class="pg-card-head"><h2 id="profileTitle"><i class="bi bi-person"></i> Profil</h2><span class="adm-badge adm-badge-info">Yönetici</span></div>
      <div class="pg-card-body">
        <div class="adm-entity mb-3">
          <span class="pg-avatar">@AdminDisplay.Initials(Model.FullName)</span>
          <div><strong>@Model.FullName</strong><small>@Model.Email</small></div>
        </div>
        <dl class="pg-dl">
          <dt>Oturum</dt><dd>30 gün; panel kullanıldıkça yenilenir</dd>
          <dt>Hatalı şifre sınırı</dt><dd>5 deneme, sonra 5 dakika bekleme</dd>
        </dl>
      </div>
    </section>
  </div>

  <div class="col-xl-7">
    <form method="post" action="/admin/account/password" class="adm-card" novalidate>
      @Html.AntiForgeryToken()
      <div class="pg-card-head"><h2><i class="bi bi-key"></i> Şifre değiştir</h2></div>
      <div class="pg-card-body">
        <div class="row g-3">
          <div class="col-12">
            <label class="adm-label" for="cur">Mevcut şifre</label>
            <input type="password" class="adm-input" id="cur" name="Password.CurrentPassword" autocomplete="current-password" required />
          </div>
          <div class="col-md-6">
            <label class="adm-label" for="new">Yeni şifre</label>
            <input type="password" class="adm-input" id="new" name="Password.NewPassword" autocomplete="new-password" minlength="8" required />
          </div>
          <div class="col-md-6">
            <label class="adm-label" for="rep">Yeni şifre (tekrar)</label>
            <input type="password" class="adm-input" id="rep" name="Password.ConfirmPassword" autocomplete="new-password" minlength="8" required />
          </div>
        </div>
        <div class="adm-hint mt-3">En az 8 karakter; büyük harf, küçük harf, rakam ve sembol içermeli.</div>
      </div>
      <div class="pg-form-foot">
        <button type="submit" class="adm-btn adm-btn-primary"><i class="bi bi-check2"></i> Şifreyi Değiştir</button>
      </div>
    </form>
  </div>
</div>
