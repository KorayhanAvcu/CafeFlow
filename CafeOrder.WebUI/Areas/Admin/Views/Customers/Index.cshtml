@model List<ResultCustomerDto>
@{
    ViewData["Title"] = "Müşteriler · CafeFlow Yönetim Paneli";
    ViewData["AdminPage"] = "customers";
    ViewData["Crumb"] = "Müşteriler";
}

<div class="adm-page-head">
  <div>
    <h1 class="adm-page-title">Müşteriler</h1>
    <p class="adm-page-sub">Teslimat ve gel-al siparişlerinden otomatik oluşur.</p>
  </div>
</div>

<section class="adm-card">
  <form class="adm-toolbar" method="get" action="/admin/customers">
    <input type="search" class="adm-input" name="q" value="@ViewBag.Search" placeholder="Ad veya telefon..." />
    <button type="submit" class="adm-btn adm-btn-light">Ara</button>
    <span class="adm-counter"><strong>@Model.Count</strong> müşteri</span>
  </form>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr><th>Müşteri</th><th>Telefon</th><th class="num">Sipariş</th><th class="end">Toplam harcama</th><th>Son sipariş</th></tr></thead>
      <tbody>
        @foreach (var c in Model)
        {
          <tr>
            <td><strong>@c.FullName</strong></td>
            <td class="pg-mono">@c.Phone</td>
            <td class="num">@c.OrderCount</td>
            <td class="end">@AdminDisplay.Money(c.TotalSpent)</td>
            <td>@(c.LastOrderDate == null ? "—" : AdminDisplay.Date(c.LastOrderDate.Value))</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</section>
