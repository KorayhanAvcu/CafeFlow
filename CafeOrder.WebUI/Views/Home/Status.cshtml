@model int
@{
    var notFound = Model == 404;
    ViewData["Title"] = (notFound ? "Sayfa bulunamadı" : "Bir şeyler ters gitti") + " — CafeFlow";
    ViewData["NavPage"] = "other";
}
@section Styles {
    <link rel="stylesheet" href="~/css/inner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}
<header class="cf-page-header">
  <div class="cf-blob cf-blob-1"></div>
  <div class="cf-blob cf-blob-2"></div>
  <div class="container position-relative">
    <h1 class="cf-page-title">@(notFound ? "Bu sayfa " : "Hay aksi, ")<em>@(notFound ? "kayıp" : "bir aksilik oldu")</em></h1>
    <p class="cf-page-sub">
      @(notFound
          ? "Aradığınız sayfa yok ya da taşınmış."
          : $"İstek tamamlanamadı (hata {Model}). Lütfen tekrar deneyin.")
    </p>
  </div>
</header>

<main class="cf-cart-section">
  <div class="container">
    <div class="cf-empty-cart">
      <span class="cf-cat-icon"><i class="bi @(notFound ? "bi-search-heart" : "bi-cup-hot")"></i></span>
      <h2>@(notFound ? "Hadi tatlı bir şey bulalım" : "Bir kez daha deneyelim")</h2>
      <p>Menümüz bir tık uzağınızda.</p>
      <a href="/products" class="btn cf-btn-primary cf-btn-lg">Menüye göz at <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
</main>
