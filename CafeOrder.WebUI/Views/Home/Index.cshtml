@model List<ResultProductDto>
@{
    ViewData["Title"] = "CafeFlow — Butik Kafe ve Online Sipariş";
    ViewData["Description"] = "CafeFlow, el yapımı kahveler ve tatlılar sunan butik bir kafe. Online, masadaki QR kodla veya gel-al sipariş verin.";
    ViewData["NavPage"] = "home";
    ViewData["BodyAttributes"] = "data-bs-spy=\"scroll\" data-bs-target=\"#mainNav\" data-bs-offset=\"100\"";
}
@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}

  <partial name="_Hero" />

  @await Component.InvokeAsync("CategoryShowcase")

  <!-- ============ 4. POPÜLER ÜRÜNLER ============ -->
  <section id="products" class="cf-section cf-section-tint">
    <div class="container">
      <div class="cf-section-head d-md-flex justify-content-between align-items-end text-md-start reveal">
        <div>
          <span class="cf-eyebrow">En sevilenler</span>
          <h2 class="cf-section-title mb-md-0">Bu haftanın popülerleri</h2>
        </div>
      </div>

      <div class="row g-4" id="productGrid">
@foreach (var product in Model)
{
        <div class="col-sm-6 col-lg-4 reveal">
          <partial name="_ProductCard" model="product" />
        </div>
}
      </div>

      <div class="text-center mt-5 reveal">
        <a href="/products" class="btn cf-btn-outline cf-btn-lg">Tüm menüyü gör <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <partial name="_OrderWays" />

  <partial name="_About" />

  <partial name="_Offer" />

  <partial name="_Reviews" />
