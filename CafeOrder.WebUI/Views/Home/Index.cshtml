@{
    ViewData["Title"] = "CafeFlow — Butik Kafe ve Online Sipariş";
    ViewData["Description"] = "CafeFlow, el yapımı kahveler ve tatlılar sunan butik bir kafe. Online, masadaki QR kodla veya gel-al sipariş verin.";
    ViewData["NavPage"] = "home";
    ViewData["BodyAttributes"] = "data-bs-spy=\"scroll\" data-bs-target=\"#mainNav\" data-bs-offset=\"100\"";
}
@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
@* Ana sayfa bölümlerden oluşur. Veri gereken bölümler (kategoriler, popüler ürünler) veriyi kendisi getirir. *@

  @await Component.InvokeAsync("_HomeHero")

  @await Component.InvokeAsync("_HomeCategoryShowcase")

  @await Component.InvokeAsync("_HomeFeaturedProducts")

  @await Component.InvokeAsync("_HomeOrderWays")

  @await Component.InvokeAsync("_HomeAbout")

  @await Component.InvokeAsync("_HomeOffer")

  @await Component.InvokeAsync("_HomeReviews")
