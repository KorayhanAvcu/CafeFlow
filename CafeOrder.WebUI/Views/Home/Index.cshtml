@model List<ResultProductDto>
@{
    ViewData["Title"] = "CafeFlow — Butik Kafe ve Online Sipariş";
    ViewData["Description"] = "CafeFlow, el yapımı kahveler ve tatlılar sunan butik bir kafe. Online, masadaki QR kodla veya gel-al sipariş verin.";
    ViewData["NavPage"] = "home";
    ViewData["BodyAttributes"] = "data-bs-spy=\"scroll\" data-bs-target=\"#mainNav\" data-bs-offset=\"100\"";
}
@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}

  <!-- ============ 2. GİRİŞ ============ -->
  <header id="home" class="cf-hero">
    <div class="cf-blob cf-blob-1"></div>
    <div class="cf-blob cf-blob-2"></div>
    <div class="container position-relative">
      <div class="row align-items-center g-5">
        <div class="col-lg-6 reveal">
          <span class="cf-eyebrow"><i class="bi bi-stars"></i> Her sabah taze pişiyor</span>
          <h1 class="cf-hero-title">
            Küçük anlar,<br />
            <em>özenle</em> demlenir.
          </h1>
          <p class="cf-hero-text">
            El yapımı kahveler, pembe rüya tatlılar ve tereyağlı hamur işleri —
            sıcacık köşe kafemizde sevgiyle hazırlanıyor. Online sipariş verin,
            masanızdan okutun ya da yolda gelip alın.
          </p>
          <div class="d-flex flex-wrap gap-3 mb-5">
            <a href="#order" class="btn cf-btn-primary cf-btn-lg">
              Online Sipariş <i class="bi bi-arrow-right"></i>
            </a>
            <a href="#menu" class="btn cf-btn-outline cf-btn-lg">
              <i class="bi bi-book"></i> Menüyü Gör
            </a>
          </div>
          <div class="cf-hero-stats">
            <div>
              <strong>4.9</strong>
              <span><i class="bi bi-star-fill"></i> 2.400 yorum</span>
            </div>
            <div class="cf-stat-divider"></div>
            <div>
              <strong>40+</strong>
              <span>İmza lezzet</span>
            </div>
            <div class="cf-stat-divider"></div>
            <div>
              <strong>15 dk</strong>
              <span>Ort. hazırlanma süresi</span>
            </div>
          </div>
        </div>

        <div class="col-lg-6 reveal">
          <div class="cf-hero-visual">
            <div class="cf-hero-arch">
              <img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=80"
                   alt="Pastel bir masada latte art yapılmış latte" data-fallback="coffee" />
            </div>
            <div class="cf-float-card cf-float-1">
              <span class="cf-float-icon"><i class="bi bi-heart-fill"></i></span>
              <div>
                <small>Günün favorisi</small>
                <strong>Çilekli Latte</strong>
              </div>
            </div>
            <div class="cf-float-card cf-float-2">
              <span class="cf-float-icon cf-icon-peach"><i class="bi bi-qr-code"></i></span>
              <div>
                <small>Kafede misiniz?</small>
                <strong>Okut &amp; sipariş ver</strong>
              </div>
            </div>
            <div class="cf-hero-badge">
              <span>Kuruluş</span>
              <strong>2019</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ============ 3. KATEGORİLER ============ -->
  <section id="menu" class="cf-section">
    <div class="container">
      <div class="cf-section-head reveal">
        <span class="cf-eyebrow">Menüyü keşfedin</span>
        <h2 class="cf-section-title">Her ruh haline tatlı bir şey</h2>
        <p class="cf-section-sub">Sabahın ilk espressosundan öğleden sonra tatlısına kadar kafemizin favorilerine göz atın.</p>
      </div>

      <div class="row g-4">
@{ var tones = new[] { "", " cf-icon-peach", " cf-icon-cream", " cf-icon-rose" }; var toneIndex = 0; }
@foreach (ResultCategoryDto category in ViewBag.Categories)
{
        <div class="col-6 col-lg-3 reveal">
          <a href="/products?category=@category.Slug" class="cf-category-card">
            <span class="cf-cat-icon@(tones[toneIndex++ % tones.Length])"><i class="bi @(category.Icon ?? "bi-tag")"></i></span>
            <h3>@category.Name</h3>
            <p>@category.Description</p>
            <span class="cf-cat-link">@category.ProductCount ürün <i class="bi bi-arrow-up-right"></i></span>
          </a>
        </div>
}
      </div>
    </div>
  </section>

  <!-- ============ 4. POPÜLER ÜRÜNLER ============ -->
  <section id="products" class="cf-section cf-section-tint">
    <div class="container">
      <div class="cf-section-head d-md-flex justify-content-between align-items-end text-md-start reveal">
        <div>
          <span class="cf-eyebrow">En sevilenler</span>
          <h2 class="cf-section-title mb-md-0">Bu haftanın popülerleri</h2>
        </div>
      </div>

      <div class="row g-4" id="productGrid">
@foreach (var product in Model)
{
        <div class="col-sm-6 col-lg-4 reveal">
          <article class="cf-product-card">
            <div class="cf-product-img">
              <img src="@product.ImageUrl" alt="@product.Name" data-fallback="@product.CategorySlug" loading="lazy" />
              @if (!string.IsNullOrEmpty(product.Badge))
              {
                <span class="cf-tag @Display.BadgeClass(product.Badge)">@product.Badge</span>
              }
            </div>
            <div class="cf-product-body">
              <h3><a href="/products/@product.Id">@product.Name</a></h3>
              <p>@product.Description</p>
              <div class="cf-product-foot">
                <span class="cf-price">@if (product.IsCustomizable) { <small>başlangıç</small> }@Display.Money(product.BasePrice)</span>
                @if (product.IsCustomizable)
                {
                  <a href="/products/@product.Id" class="btn cf-add-btn"><i class="bi bi-sliders"></i> Özelleştir</a>
                }
                else
                {
                  <form method="post" asp-controller="Cart" asp-action="Add" class="d-inline">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="hidden" name="returnUrl" value="/#products" />
                    <button type="submit" class="btn cf-add-btn"><i class="bi bi-plus-lg"></i> Ekle</button>
                  </form>
                }
              </div>
            </div>
          </article>
        </div>
}
      </div>

      <div class="text-center mt-5 reveal">
        <a href="/products" class="btn cf-btn-outline cf-btn-lg">Tüm menüyü gör <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <!-- ============ 5. NASIL İSTERSENİZ ÖYLE SİPARİŞ ============ -->
  <section id="order" class="cf-section">
    <div class="container">
      <div class="cf-section-head reveal">
        <span class="cf-eyebrow">Kolay sipariş</span>
        <h2 class="cf-section-title">Nasıl isterseniz öyle sipariş verin</h2>
        <p class="cf-section-sub">Evde, masanızda ya da yolda — CafeFlow gününüze uyum sağlar.</p>
      </div>

      <div class="row g-4 cf-steps">
        <div class="col-md-4 reveal">
          <div class="cf-order-card">
            <span class="cf-order-num">01</span>
            <span class="cf-order-icon"><i class="bi bi-phone"></i></span>
            <h3>Online Sipariş</h3>
            <p>Menüye göz atın, içeceğinizi özelleştirin ve her cihazdan kolayca sipariş verin. Siz hazır olduğunuzda biz de hazırız.</p>
            <a href="#products" class="cf-text-link">Siparişe başla <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-md-4 reveal">
          <div class="cf-order-card cf-order-featured">
            <span class="cf-order-num">02</span>
            <span class="cf-order-icon"><i class="bi bi-qr-code-scan"></i></span>
            <h3>Masadan QR Sipariş</h3>
            <p>Zaten kafede misiniz? Masanızdaki QR kodu okutun, saniyeler içinde sipariş verin; her şeyi masanıza getirelim.</p>
            <a href="#products" class="cf-text-link">Nasıl çalışır? <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
        <div class="col-md-4 reveal">
          <div class="cf-order-card">
            <span class="cf-order-num">03</span>
            <span class="cf-order-icon"><i class="bi bi-bag-check"></i></span>
            <h3>Gel-Al</h3>
            <p>Önceden sipariş verin, sıra beklemeden tezgâhımızdan alın — genellikle 15 dakikada hazır.</p>
            <a href="#contact" class="cf-text-link">Kafeyi bul <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 6. HAKKIMIZDA ============ -->
  <section id="about" class="cf-section cf-section-cream">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-6 reveal">
          <div class="cf-collage">
            <div class="cf-collage-main">
              <img src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&w=800&q=80"
                   alt="Yumuşak ışıklı, sıcak bir kafe içi" data-fallback="cafe" loading="lazy" />
            </div>
            <div class="cf-collage-side">
              <img src="https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=600&q=80"
                   alt="Bardakta meyveli tatlı" data-fallback="cake" loading="lazy" />
            </div>
            <div class="cf-collage-note">
              <i class="bi bi-flower1"></i>
              <span>Sevgiyle pişer, gülümsemeyle servis edilir.</span>
            </div>
          </div>
        </div>

        <div class="col-lg-6 reveal">
          <span class="cf-eyebrow">Hikâyemiz</span>
          <h2 class="cf-section-title text-start">Ağır sabahlar için pembe bir köşe</h2>
          <p class="cf-body-lg">
            CafeFlow, tek bir espresso makinesi ve güzel tatlılara duyulan büyük bir
            sevgiyle küçük bir tezgâhta başladı. Bugün arkadaş buluşmalarının, ilk
            randevuların, sessiz okuma saatlerinin ve aradaki her türlü kutlamanın adresi.
          </p>
          <div class="row g-3 mt-2">
            <div class="col-sm-6">
              <div class="cf-feature">
                <span class="cf-feature-icon"><i class="bi bi-house-heart"></i></span>
                <div>
                  <h4>Sıcak atmosfer</h4>
                  <p>Yumuşak ışık, rahat koltuklar ve güzel müzik.</p>
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="cf-feature">
                <span class="cf-feature-icon"><i class="bi bi-flower2"></i></span>
                <div>
                  <h4>Taze malzemeler</h4>
                  <p>Yerel süt ürünleri, mevsim meyveleri, gerçek tereyağı.</p>
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="cf-feature">
                <span class="cf-feature-icon"><i class="bi bi-cup-hot"></i></span>
                <div>
                  <h4>El yapımı içecekler</h4>
                  <p>Küçük partilerde kavrulan nitelikli çekirdekler.</p>
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="cf-feature">
                <span class="cf-feature-icon"><i class="bi bi-cake"></i></span>
                <div>
                  <h4>Günlük tatlılar</h4>
                  <p>Her sabah kendi mutfağımızda pişiyor.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 7. KAMPANYA ============ -->
  <section class="cf-section">
    <div class="container">
      <div class="cf-offer reveal">
        <div class="cf-offer-shape"></div>
        <div class="row align-items-center g-4 position-relative">
          <div class="col-lg-7">
            <span class="cf-offer-pill"><i class="bi bi-gift"></i> Sınırlı süre · Hafta içi 14:00–17:00</span>
            <h2 class="cf-offer-title">Tatlı Pembe Menü</h2>
            <p class="cf-offer-text">
              Dilediğiniz el yapımı latte + bir dilim Pembe Kadife Pasta. Ödemede <strong>PINK20</strong> kodunu kullanın,
              %20 indirim kazanın — öğleden sonraya mükemmel bir mola.
            </p>
            <div class="d-flex flex-wrap align-items-center gap-4">
              <div class="cf-offer-price">
                <span class="cf-old">₺385,00</span>
                <span class="cf-new">₺308,00</span>
              </div>
              <a href="/products?category=pastalar" class="btn cf-btn-dark cf-btn-lg">
                Menüyü yakala <i class="bi bi-arrow-right"></i>
              </a>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="cf-offer-visual">
              <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=700&q=80"
                   alt="Kahve ve tatlı menüsü" data-fallback="coffee" loading="lazy" />
              <div class="cf-offer-badge">
                <strong>-%20</strong>
                <span>indirim</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 8. YORUMLAR ============ -->
  <section class="cf-section cf-section-tint">
    <div class="container">
      <div class="cf-section-head reveal">
        <span class="cf-eyebrow">Güzel sözler</span>
        <h2 class="cf-section-title">Misafirlerimiz anlatsın</h2>
      </div>

      <div class="row g-4">
        <div class="col-md-4 reveal">
          <figure class="cf-review">
            <div class="cf-stars" aria-label="5 üzerinden 5 yıldız">
              <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
            </div>
            <blockquote>“Çilekli latte inanılmaz, kafe de çok şirin. Masadaki QR ile sipariş vermek çok hızlıydı — hiç beklemedik.”</blockquote>
            <figcaption>
              <span class="cf-avatar">EY</span>
              <div><strong>Elif Yıldız</strong><small>Müdavim</small></div>
            </figcaption>
          </figure>
        </div>
        <div class="col-md-4 reveal">
          <figure class="cf-review cf-review-featured">
            <div class="cf-stars" aria-label="5 üzerinden 5 yıldız">
              <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
            </div>
            <blockquote>“Her sabah işe giderken gel-al sipariş veriyorum. Hep zamanında hazır, Lotus Cheesecake de haftalık ödülüm.”</blockquote>
            <figcaption>
              <span class="cf-avatar cf-avatar-peach">DM</span>
              <div><strong>Deniz Metin</strong><small>Gel-al sever</small></div>
            </figcaption>
          </figure>
        </div>
        <div class="col-md-4 reveal">
          <figure class="cf-review">
            <div class="cf-stars" aria-label="5 üzerinden 4,5 yıldız">
              <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
            </div>
            <blockquote>“Sakin, rahat ve çok zevkli dekore edilmiş. Kız kardeşimin doğum gününü burada kutladık, kruvasan kutusu çok beğenildi.”</blockquote>
            <figcaption>
              <span class="cf-avatar cf-avatar-cream">SA</span>
              <div><strong>Selin Arslan</strong><small>Hafta sonu misafiri</small></div>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>
