@* Tek ürün kartı: menüde, "Yanında iyi gider" bölümünde ve sepet önerilerinde kullanılır. *@
@model ResultProductDto
<article class="cf-product-card">
  <div class="cf-product-img">
    <a href="/products/@Model.Id" class="cf-product-img-link" aria-label="@Model.Name detaylarını gör">
      <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" data-fallback="@Model.CategorySlug" />
    </a>
    @if (Model.Badge != null)
    {
      <span class="cf-tag @Display.BadgeClass(Model.Badge)">@Model.Badge</span>
    }
  </div>
  <div class="cf-product-body">
    <div class="cf-product-meta">
      <span class="cf-cat-label">@Model.CategoryName</span>
      @if (Model.IsVegetarian)
      {
        <span class="cf-veg" title="Vejetaryen"><i class="bi bi-flower2"></i> Vejetaryen</span>
      }
    </div>
    <h3><a href="/products/@Model.Id">@Model.Name</a></h3>
    <p>@Model.Description</p>
    <div class="cf-product-foot">
      <span class="cf-price">@if (Model.IsCustomizable) { <small>başlangıç</small> }@Display.Money(Model.BasePrice)</span>
      @if (Model.IsCustomizable)
      {
        <a href="/products/@Model.Id" class="btn cf-add-btn"><i class="bi bi-sliders"></i> Özelleştir</a>
      }
      else
      {
        <form method="post" asp-controller="Cart" asp-action="Add" class="d-inline">
          <input type="hidden" name="productId" value="@Model.Id" />
          <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
          <button type="submit" class="btn cf-add-btn"><i class="bi bi-bag-plus"></i> Ekle</button>
        </form>
      }
    </div>
  </div>
</article>
