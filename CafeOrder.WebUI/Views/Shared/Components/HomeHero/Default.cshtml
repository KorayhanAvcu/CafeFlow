@* Ana sayfa giriş (hero) bölümü: başlık, butonlar, istatistikler ve görsel. Statik içerik. *@
<!-- ============ 2. GİRİŞ ============ -->
<header id="home" class="cf-hero">
  <div class="cf-blob cf-blob-1"></div>
  <div class="cf-blob cf-blob-2"></div>
  <div class="container position-relative">
    <div class="row align-items-center g-5">
      <div class="col-lg-6 reveal">
        <span class="cf-eyebrow"><i class="bi bi-stars"></i> Her sabah taze pişiyor</span>
        <h1 class="cf-hero-title">
          Küçük anlar,<br />
          <em>özenle</em> demlenir.
        </h1>
        <p class="cf-hero-text">
          El yapımı kahveler, pembe rüya tatlılar ve tereyağlı hamur işleri —
          sıcacık köşe kafemizde sevgiyle hazırlanıyor. Online sipariş verin,
          masanızdan okutun ya da yolda gelip alın.
        </p>
        <div class="d-flex flex-wrap gap-3 mb-5">
          <a href="#order" class="btn cf-btn-primary cf-btn-lg">
            Online Sipariş <i class="bi bi-arrow-right"></i>
          </a>
          <a href="#menu" class="btn cf-btn-outline cf-btn-lg">
            <i class="bi bi-book"></i> Menüyü Gör
          </a>
        </div>
        <div class="cf-hero-stats">
          <div>
            <strong>4.9</strong>
            <span><i class="bi bi-star-fill"></i> 2.400 yorum</span>
          </div>
          <div class="cf-stat-divider"></div>
          <div>
            <strong>40+</strong>
            <span>İmza lezzet</span>
          </div>
          <div class="cf-stat-divider"></div>
          <div>
            <strong>15 dk</strong>
            <span>Ort. hazırlanma süresi</span>
          </div>
        </div>
      </div>

      <div class="col-lg-6 reveal">
        <div class="cf-hero-visual">
          <div class="cf-hero-arch">
            <img src="https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=900&q=80"
                 alt="Pastel bir masada latte art yapılmış latte" data-fallback="coffee" />
          </div>
          <div class="cf-float-card cf-float-1">
            <span class="cf-float-icon"><i class="bi bi-heart-fill"></i></span>
            <div>
              <small>Günün favorisi</small>
              <strong>Çilekli Latte</strong>
            </div>
          </div>
          <div class="cf-float-card cf-float-2">
            <span class="cf-float-icon cf-icon-peach"><i class="bi bi-qr-code"></i></span>
            <div>
              <small>Kafede misiniz?</small>
              <strong>Okut &amp; sipariş ver</strong>
            </div>
          </div>
          <div class="cf-hero-badge">
            <span>Kuruluş</span>
            <strong>2019</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
