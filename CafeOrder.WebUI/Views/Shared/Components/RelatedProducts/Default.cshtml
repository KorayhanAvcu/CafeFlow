@* RelatedProductsViewComponent: aynı kategoriden benzer ürünler. Liste boşsa hiçbir şey çizilmez. *@
@model List<ResultProductDto>
@if (Model.Count > 0)
{
  <section class="cf-related">
    <div class="container">
      <div class="cf-section-head">
        <span class="cf-eyebrow">Yanında iyi gider</span>
        <h2 class="cf-section-title">Bunlara da Bayılabilirsiniz...</h2>
      </div>
      <div class="row g-4">
        @foreach (var product in Model)
        {
          <div class="col-12 col-sm-6 col-lg-3">
            <partial name="_ProductCard" model="product" />
          </div>
        }
      </div>
    </div>
  </section>
}
