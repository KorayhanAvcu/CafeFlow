@* _LayoutFooterViewComponent: model = sayfa adı; ana sayfada linkler sayfa içi çapalara gider. *@
@model string
@{
    var isHome = Model == "home";
}
<!-- ============ FOOTER (bütün müşteri sayfalarında ortak) ============ -->
<footer id="contact" class="cf-footer">
  <div class="container">
    <div class="row g-5 cf-footer-main">
      <div class="col-lg-4">
        <a class="cf-logo mb-3 d-inline-flex" href="@(isHome ? "#home" : "/")">
          <span class="cf-logo-mark"><i class="bi bi-cup-hot-fill"></i></span>
          Cafe<span>Flow</span>
        </a>
        <p class="cf-footer-text">El yapımı kahveler, güzel tatlılar ve yavaş, mutlu anlar için butik bir kafe.</p>
        <div class="cf-socials">
          <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
          <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
          <a href="#" aria-label="Pinterest"><i class="bi bi-pinterest"></i></a>
          <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
        </div>
      </div>

      <div class="col-6 col-lg-2">
        <h5>Keşfet</h5>
        <ul class="cf-footer-links">
          <li><a href="@(isHome ? "#home" : "/")">Ana Sayfa</a></li>
          <li><a href="/products">Menü</a></li>
          <li><a href="@(isHome ? "#about" : "/#about")">Hakkımızda</a></li>
          <li><a href="@(isHome ? "#order" : "/#order")">Sipariş</a></li>
        </ul>
      </div>

      <div class="col-6 col-lg-3">
        <h5>Bizi ziyaret edin</h5>
        <ul class="cf-contact-list">
          <li><i class="bi bi-geo-alt"></i> Gül Sokak No:24, Moda, Kadıköy / İstanbul</li>
          <li><i class="bi bi-telephone"></i> <a href="tel:+902165550142">0216 555 01 42</a></li>
          <li><i class="bi bi-envelope"></i> <a href="mailto:merhaba@cafeflow.com">merhaba@cafeflow.com</a></li>
        </ul>
      </div>

      <div class="col-lg-3">
        <h5>Çalışma saatleri</h5>
        <ul class="cf-hours">
          <li><span>Pzt – Cuma</span><span>07:30 – 21:00</span></li>
          <li><span>Cumartesi</span><span>08:30 – 22:00</span></li>
          <li><span>Pazar</span><span>09:00 – 20:00</span></li>
        </ul>
      </div>
    </div>

    <div class="cf-footer-bottom">
      <span>© @DateTime.Now.Year CafeFlow. Tüm hakları saklıdır.</span>
      <span><i class="bi bi-heart-fill"></i> ve güzel kahveyle yapıldı.</span>
    </div>
  </div>
</footer>
