@* Model: hatayı sunucu loglarında bulmaya yarayan istek numarası (HomeController.Error verir). *@
@model string?
@{
    ViewData["Title"] = "Bir şeyler ters gitti — CafeFlow";
    ViewData["NavPage"] = "other";
}
@section Styles {
    <link rel="stylesheet" href="~/css/inner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}
<header class="cf-page-header">
  <div class="cf-blob cf-blob-1"></div>
  <div class="cf-blob cf-blob-2"></div>
  <div class="container position-relative">
    <h1 class="cf-page-title">Hay aksi, <em>bir aksilik oldu</em></h1>
    <p class="cf-page-sub">Bizim tarafımızda bir sorun oluştu. Sipariş bilgileriniz değişmedi.</p>
  </div>
</header>

<main class="cf-cart-section">
  <div class="container">
    <div class="cf-empty-cart">
      <span class="cf-cat-icon"><i class="bi bi-cup-hot"></i></span>
      <h2>Bir kez daha deneyelim</h2>
      @if (!string.IsNullOrEmpty(Model))
      {
        <p>Referans: <code>@Model</code></p>
      }
      <a href="/" class="btn cf-btn-primary cf-btn-lg">Ana sayfaya dön <i class="bi bi-arrow-right"></i></a>
    </div>
  </div>
</main>
