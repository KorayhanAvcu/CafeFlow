@model ResultCartDto
@{
    ViewData["Title"] = "Sepetiniz — CafeFlow";
    ViewData["NavPage"] = "cart";

    // Bütün veri CartService.GetCartAsync'ten gelen ResultCartDto'da.
    OrderChannel? channel = Model.Channel;
    var isEmpty = Model.Order.Details.Count == 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/inner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

  <vc:cart-header />

  <main class="cf-cart-section">
    <div class="container">
      @if (Model.Error != null)
      {
        <div class="cf-notice mb-4" role="alert">
          <i class="bi bi-exclamation-circle"></i>
          <div><strong>Siparişinizi alamadık</strong>@Model.Error</div>
        </div>
      }

      <div class="row g-4">
        <div class="col-lg-8">

          <vc:cart-items cart="@Model" />

          @if (!isEmpty)
          {
            <vc:channel-picker cart="@Model" />

            <!-- 3. Bilgiler ve sipariş -->
            @if (channel != null)
            {
              <vc:checkout-form cart="@Model" />
            }
          }
        </div>

        <vc:cart-summary cart="@Model" />
      </div>
    </div>
  </main>
