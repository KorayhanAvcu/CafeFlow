@model ResultCartDto
@{
    ViewData["Title"] = "Sepetiniz — CafeFlow";
    ViewData["NavPage"] = "cart";

    // Bütün veri CartService.GetCartAsync'ten gelen ResultCartDto'da.
    ResultOrderDto order = Model.Order;
    OrderChannel? channel = Model.Channel;
    ResultTableDto? table = Model.Table;
    CreateOrderDto form = Model.Form;   // formda yazılanlar (hata olunca geri gelir)
    var isEmpty = order.Details.Count == 0;
    OrderChannel[] channels = { OrderChannel.Delivery, OrderChannel.Pickup, OrderChannel.Table };
}
@section Styles {
    <link rel="stylesheet" href="~/css/inner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true" />
}

  <header class="cf-page-header cf-compact">
    <div class="cf-blob cf-blob-1"></div>
    <div class="cf-blob cf-blob-2"></div>
    <div class="container position-relative">
      <h1 class="cf-page-title">Tatlı <em>Sepetiniz</em></h1>
      <p class="cf-page-sub">En sevdiğiniz lezzetler yola çıkmak üzere!</p>
    </div>
  </header>

  <main class="cf-cart-section">
    <div class="container">
      @if (Model.Error != null)
      {
        <div class="cf-notice mb-4" role="alert">
          <i class="bi bi-exclamation-circle"></i>
          <div><strong>Siparişinizi alamadık</strong>@Model.Error</div>
        </div>
      }

      <div class="row g-4">
        <div class="col-lg-8">

          <!-- 1. Ürünler -->
          <section class="cf-panel">
            <div class="cf-panel-head">
              <h2 class="cf-panel-title"><span class="cf-step">1</span> Ürünleriniz</h2>
              @if (!isEmpty)
              {
                <form method="post" asp-action="Clear">
                  <button type="submit" class="cf-clear-btn"><i class="bi bi-trash3"></i> Sepeti boşalt</button>
                </form>
              }
            </div>

            @if (isEmpty)
            {
              <div class="cf-empty-cart">
                <h2>Sepetiniz biraz yalnız görünüyor...</h2>
                <p>Hadi onu tatlı bir şeyle dolduralım!</p>
                <a href="/products" class="btn cf-btn-primary cf-btn-lg">Menümüzü Keşfedin <i class="bi bi-arrow-right"></i></a>
              </div>
            }

            @for (var i = 0; i < order.Details.Count; i++)
            {
              var line = order.Details[i];
              <article class="cf-item">
                <a href="/products/@line.ProductId" class="cf-item-thumb">
                  <img src="@line.ProductImageUrl" alt="@line.ProductName" data-fallback="@line.ProductCategorySlug" />
                </a>
                <div class="cf-item-info">
                  <span class="cf-cat-label">@line.ProductCategoryName</span>
                  <h3 class="cf-item-name"><a href="/products/@line.ProductId">@line.ProductName</a></h3>
                  @if (line.Options.Count > 0)
                  {
                    <div class="cf-opt-tags">
                      @foreach (var option in line.Options)
                      {
                        <span class="cf-opt-tag">@Display.OptionText(option.GroupKey, option.Value)</span>
                      }
                    </div>
                  }
                  <form method="post" asp-action="Update" class="cf-item-actions">
                    <input type="hidden" name="index" value="@i" />
                    <button type="submit" name="quantity" value="0" class="cf-link-btn muted"><i class="bi bi-trash3"></i> Kaldır</button>
                  </form>
                </div>
                <div class="cf-item-side">
                  <span class="cf-unit">Adedi @Display.Money(line.UnitPrice)</span>
                  <form method="post" asp-action="Update" class="cf-stepper">
                    <input type="hidden" name="index" value="@i" />
                    <button type="submit" name="quantity" value="@(line.Quantity - 1)" aria-label="Azalt"><i class="bi bi-dash"></i></button>
                    <span>@line.Quantity</span>
                    <button type="submit" name="quantity" value="@(line.Quantity + 1)" aria-label="Artır"><i class="bi bi-plus"></i></button>
                  </form>
                  <span class="cf-line-total">@Display.Money(line.LineTotal)</span>
                </div>
              </article>
            }
          </section>

          @if (!isEmpty)
          {
            <!-- 2. Sipariş türü: seçip "Devam" denince sunucuya gider, ücret yeniden hesaplanır -->
            <section class="cf-panel" id="orderType">
              <div class="cf-panel-head">
                <h2 class="cf-panel-title"><span class="cf-step">2</span> Siparişinizi Nasıl Almak İstersiniz?</h2>
              </div>
              <form method="post" asp-action="Channel">
                <div class="cf-type-grid">
                  @foreach (OrderChannel item in channels)
                  {
                    <label class="cf-type">
                      <input type="radio" name="channel" value="@item" checked="@(channel == item)" />
                      <span class="cf-type-card">
                        <span class="cf-type-check"><i class="bi bi-check-lg"></i></span>
                        <span class="cf-type-icon"><i class="bi @Display.ChannelIcon(item)"></i></span>
                        <span class="cf-type-text">
                          <span class="cf-type-name">@Display.ChannelName(item)</span>
                          <span class="cf-type-desc">@Display.ChannelText(item)</span>
                        </span>
                      </span>
                    </label>
                  }
                </div>
                <button type="submit" class="btn cf-btn-outline mt-3">Devam</button>
              </form>
            </section>

            <!-- 3. Bilgiler ve sipariş -->
            @if (channel != null)
            {
              <section class="cf-panel">
                <div class="cf-panel-head">
                  <h2 class="cf-panel-title"><span class="cf-step">3</span> Bilgileriniz</h2>
                </div>
                <form method="post" asp-action="Checkout" id="checkoutForm" class="cf-details">
                  @if (channel == OrderChannel.Table)
                  {
                    if (table != null)
                    {
                      <div class="cf-table-card">
                        <span class="cf-table-num">@table.Number</span>
                        <div><small>Sipariş verdiğiniz masa</small><strong>Masa @table.Number · @table.Area</strong></div>
                      </div>
                    }
                    else
                    {
                      <div class="cf-notice">
                        <i class="bi bi-qr-code-scan"></i>
                        <div>
                          <strong>Masanızdaki QR kodu okutun</strong>
                          <a href="/cart?qr=CF-T07-GUL" class="cf-text-link">Masa okutmayı dene (demo)</a>
                        </div>
                      </div>
                    }
                  }
                  else
                  {
                    <div class="row g-3 pb-3">
                      <div class="col-md-6">
                        <label class="cf-label" for="fullName">Ad Soyad</label>
                        <input class="cf-input" id="fullName" name="FullName" value="@form.FullName" />
                      </div>
                      <div class="col-md-6">
                        <label class="cf-label" for="phone">Telefon</label>
                        <input class="cf-input" id="phone" name="Phone" value="@form.Phone" />
                      </div>
                      @if (channel == OrderChannel.Delivery)
                      {
                        <div class="col-12">
                          <label class="cf-label" for="address">Teslimat Adresi</label>
                          <textarea class="cf-textarea" id="address" name="Address" rows="2">@form.Address</textarea>
                        </div>
                        <div class="col-12">
                          <label class="cf-label" for="addressNotes">Adres Notu (isteğe bağlı)</label>
                          <input class="cf-input" id="addressNotes" name="AddressNotes" value="@form.AddressNotes" />
                        </div>
                      }
                      @if (channel == OrderChannel.Pickup)
                      {
                        <div class="col-md-6">
                          <label class="cf-label" for="pickupTime">Teslim Alma Saati</label>
                          <input class="cf-input" id="pickupTime" name="PickupTime" type="datetime-local" value="@form.PickupTime?.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                      }
                    </div>
                  }
                  <label class="cf-label" for="note">Not (isteğe bağlı)</label>
                  <textarea class="cf-textarea" id="note" name="Note" rows="2" maxlength="300">@form.Note</textarea>
                </form>
              </section>
            }
          }
        </div>

        <!-- Özet: bütün tutarları OrderService.CalculateAsync hesapladı -->
        <div class="col-lg-4">
          <aside class="cf-summary" id="summary">
            <div class="cf-summary-head"><h2>Sipariş Özeti</h2></div>
            <div class="cf-summary-body">
              <ul class="cf-sum-rows">
                <li><span>Ara toplam</span><span>@Display.Money(order.Subtotal)</span></li>
                <li><span>Teslimat Ücreti</span><span>@(channel == null ? "—" : order.DeliveryFee == 0 ? "Ücretsiz" : Display.Money(order.DeliveryFee))</span></li>
              </ul>
              @if (channel == OrderChannel.Delivery && order.DeliveryFee > 0)
              {
                <p class="small text-muted">@Display.Money(Model.FreeDeliveryFrom) ve üzeri siparişlerde teslimat ücretsiz.</p>
              }

              <div class="cf-grand">
                <span>Toplam</span>
                <strong>@Display.Money(order.Total)</strong>
              </div>

              <button type="submit" form="checkoutForm" class="btn cf-btn-primary cf-btn-lg w-100" disabled="@(isEmpty || channel == null)">
                <i class="bi bi-lock"></i> Siparişi Ver
              </button>
              @if (!isEmpty && channel == null)
              {
                <p class="small text-muted mt-2">Önce siparişinizi nasıl almak istediğinizi seçin.</p>
              }
            </div>
          </aside>
        </div>
      </div>
    </div>
  </main>
