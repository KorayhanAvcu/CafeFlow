@{
    ViewData["Title"] = "Treat not found — CafeFlow";
    ViewData["NavPage"] = "detail";
}
@section Styles {
    <link rel="stylesheet" href="~/css/inner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />
}

  <div class="cf-detail-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <div class="cf-breadcrumb">
          <a href="/"><i class="bi bi-house-heart"></i> Home</a>
          <i class="bi bi-chevron-right"></i>
          <a href="/products">Our Menu</a>
          <i class="bi bi-chevron-right"></i>
          <span aria-current="page">Not found</span>
        </div>
      </nav>
    </div>
  </div>

  <main>
    <section class="cf-not-found container">
      <div class="cf-empty-art"><span><i class="bi bi-search-heart"></i></span></div>
      <h1>We couldn't find that treat</h1>
      <p>It may have left the menu, or the link might be incomplete.</p>
      <a href="/products" class="btn cf-btn-primary cf-btn-lg">Explore Our Menu <i class="bi bi-arrow-right"></i></a>
    </section>
  </main>
