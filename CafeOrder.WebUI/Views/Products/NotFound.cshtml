@{
    ViewData["Title"] = "Ürün bulunamadı — CafeFlow";
    ViewData["NavPage"] = "detail";
}
@section Styles {
    <link rel="stylesheet" href="~/css/inner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />
}

  <div class="cf-detail-head">
    <div class="container">
      <nav aria-label="Sayfa yolu">
        <div class="cf-breadcrumb">
          <a href="/"><i class="bi bi-house-heart"></i> Ana Sayfa</a>
          <i class="bi bi-chevron-right"></i>
          <a href="/products">Menümüz</a>
          <i class="bi bi-chevron-right"></i>
          <span aria-current="page">Bulunamadı</span>
        </div>
      </nav>
    </div>
  </div>

  <main>
    <section class="cf-not-found container">
      <div class="cf-empty-art"><span><i class="bi bi-search-heart"></i></span></div>
      <h1>Bu ürünü bulamadık</h1>
      <p>Menüden kalkmış olabilir ya da bağlantı eksik olabilir.</p>
      <a href="/products" class="btn cf-btn-primary cf-btn-lg">Menümüzü Keşfedin <i class="bi bi-arrow-right"></i></a>
    </section>
  </main>
